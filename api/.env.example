# Conexão com o PostgreSQL (desenvolvimento)
DATABASE_URL="postgresql://bebmais_auth:SUA_SENHA@localhost:5432/bebmais_auth?schema=public"

# Segredo do access token JWT: mínimo de 32 caracteres, aleatório
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# Senha inicial do ADMIN master. Só é exigida enquanto o master não existir.
# Regras: mínimo 8 caracteres, pelo menos 1 letra maiúscula e 1 número.
SEED_ADMIN_PASSWORD=""

# Validade do access token (formato do jsonwebtoken: 15m, 1h, etc.)
ACCESS_TOKEN_TTL=15m

PORT=3333
NODE_ENV=development
